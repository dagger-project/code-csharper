{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // Strict by default. Every rule turned off below says why.
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "promise", "node"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "pedantic": "error"
  },
  "options": {
    // Type-aware rules run on tsgolint, which is built on the TypeScript 7 compiler.
    "typeAware": true,
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error"
  },
  "env": { "node": true, "es2024": true },
  "ignorePatterns": ["dist"],
  "rules": {
    "eqeqeq": ["error", "always"],
    "no-console": "error",
    "prefer-const": "error",
    "no-var": "error",

    "typescript/consistent-type-imports": ["error", { "fixStyle": "inline-type-imports" }],
    "typescript/consistent-type-definitions": ["error", "type"],
    "typescript/explicit-module-boundary-types": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-import-type-side-effects": "error",
    "typescript/no-unused-vars": [
      "error",
      { "ignoreRestSiblings": true, "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }
    ],

    // Type-aware
    "typescript/await-thenable": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unnecessary-condition": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/restrict-template-expressions": ["error", { "allowNumber": true }],
    "typescript/strict-boolean-expressions": [
      "error",
      { "allowString": false, "allowNumber": false, "allowNullableObject": true }
    ],
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/prefer-nullish-coalescing": "error",
    "typescript/prefer-optional-chain": "error",
    "typescript/return-await": ["error", "in-try-catch"],
    "typescript/only-throw-error": "error",
    "typescript/no-confusing-void-expression": ["error", { "ignoreArrowShorthand": true }],

    // Off, with reasons:
    // The VS Code API hands out mutable types everywhere; readonly parameters are noise.
    "typescript/prefer-readonly-parameter-types": "off",
    // Misfires on exhaustive switches; tsconfig's noImplicitReturns covers it.
    "typescript/consistent-return": "off",
    // Size is reviewed, not counted.
    "max-lines": "off",
    "max-lines-per-function": "off",
    "max-depth": "off",
    // Builds and test runs happen one after another on purpose.
    "no-await-in-loop": "off",
    // `.filter(isNode)` with a type guard is clearer than a lambda.
    "unicorn/no-array-callback-reference": "off"
  },
  "overrides": [
    {
      "files": ["**/*.test.ts"],
      "rules": {
        // node:test's test() returns a promise the runner tracks itself.
        "typescript/no-floating-promises": "off",
        // Optional chains on indexed results keep assertions readable.
        "typescript/no-unnecessary-condition": "off"
      }
    },
    {
      "files": ["test/e2e/**"],
      "rules": {
        // The launcher reports to the terminal.
        "no-console": "off",
        // Debug adapter responses come back untyped from customRequest.
        "typescript/no-unsafe-type-assertion": "off"
      }
    }
  ]
}
